    "api_providers": {
      "templates": {
        "gemini": {
          "capability_options": {
            "labels": [
              "文生图",
              "图生图",
              "宽高比",
              "分辨率"
            ]
          }
        },
        "openai_chat": {
          "capability_options": {
            "labels": [
              "文生图",
              "图生图",
              "宽高比",
              "分辨率"
            ]
          }
        },
        "openai": {
          "capability_options": {
            "labels": [
              "文生图",
              "图生图",
              "宽高比",
              "分辨率"
            ]
          },
          "model_family": {
            "labels": [
              "自动",
              "GPT Image",
              "DALL·E"
            ]
          },
          "enable_streaming": {
            "description": "使用 SSE 流式请求",
            "hint": "文生图默认开启 SSE。部分兼容站点不支持流式时可关闭，改为普通 JSON 响应。"
          },
          "output_format": {
            "description": "GPT Image 输出格式",
            "hint": "PNG 保留无损质量；JPEG 响应更小，适合会截断大型 Base64 响应的中转接口。仅影响 GPT Image 系列。",
            "labels": [
              "png",
              "jpeg",
              "webp"
            ]
          }
        },
        "novelai": {
          "name": "NovelAI 原生 JSON 接口",
          "hint": "使用 NovelAI 原生请求结构，先报价再生成。聊天指令与 LLM 工具仅使用四种标准尺寸；WebUI 可手动填写宽高，仍受单次请求 Gems 上限保护。支持文生图与单参考图图生图，返回 JSON Base64 图片。",
          "base_url": {
            "description": "接口地址",
            "hint": "默认使用 https://nai.rinko.ai；兼容服务需同时支持 /ai/generate-image/quote 报价和 /v1/nai/generate-image 原生请求体、JSON 图片响应。"
          },
          "proxy": {
            "description": "代理地址",
            "hint": "可选，示例：http://127.0.0.1:7890。"
          },
          "api_keys": {
            "description": "API 密钥",
            "hint": "填写该服务的 API Key 或 Token（例如 ynai-…）；单次生成及重试固定使用同一个 Key。"
          },
          "available_models": {
            "description": "可用模型列表",
            "hint": "用于 /生图模型 命令切换；请按账号实际可用模型维护。V4 / V4.5 提示词结构由适配器自动组装。"
          },
          "capability_options": {
            "description": "模型能力",
            "hint": "支持文生图、单参考图图生图和宽高比。聊天/LLM 将比例匹配到 512×512、832×1216、1216×832、1024×1024；WebUI 可手动填写宽高。全局分辨率不生效；标准尺寸不保证图生图或高步数免费。",
            "labels": [
              "文生图",
              "图生图",
              "宽高比"
            ]
          },
          "timeout": {
            "description": "超时时间覆盖（秒）",
            "hint": "推荐 330 秒，覆盖服务端最长 300 秒生成时间；填 0 使用运行控制的超时。超时后请在服务端生成日志核对任务状态。"
          },
          "max_retry_attempts": {
            "description": "最大尝试次数覆盖",
            "hint": "默认 1 表示仅发送一次；填 0 使用运行控制的设置。仅传输异常重试，复用同一幂等键、请求体和 API Key；HTTP 错误与无效结果不重发，需在服务端核对原任务。"
          },
          "max_cost_gems": {
            "description": "单次请求 Gems 上限",
            "hint": "非负数，默认 5；0 仅允许零报价。文生图和图生图均先用相同请求体查询 /ai/generate-image/quote，超限或报价失败不生成。每个子请求独立限制，不是整个多图任务的总预算；服务端生成时会重新计价。"
          },
          "width": {
            "description": "默认图片宽度",
            "hint": "用于聊天/LLM 标准尺寸匹配的比例与面积基准，也是 WebUI 宽度默认值；范围 64–2048，必须是 64 的倍数，宽×高不能超过 3,145,728 像素。"
          },
          "height": {
            "description": "默认图片高度",
            "hint": "用于聊天/LLM 标准尺寸匹配的比例与面积基准，也是 WebUI 高度默认值；范围 64–2048，必须是 64 的倍数，宽×高不能超过 3,145,728 像素。"
          },
          "steps": {
            "description": "采样步数",
            "hint": "范围 1–50；具体价格和免费渲染条件以服务端为准。"
          },
          "sampler": {
            "description": "采样器",
            "hint": "填写模型支持的原生 sampler 名称，例如 k_euler_ancestral。"
          },
          "scale": {
            "description": "提示词遵循强度（CFG）",
            "hint": "范围 0–10；数值越高通常越遵循提示词。"
          },
          "seed": {
            "description": "随机种子",
            "hint": "-1 表示每次生成随机种子；固定非负整数可用于复现相同参数。重试保持同一个种子。"
          },
          "negative_prompt": {
            "description": "负向提示词",
            "hint": "可选，用于描述希望避免的内容；V4 / V4.5 的负向提示词结构会自动组装，不自动追加质量标签或 UC 预设。"
          },
          "noise_schedule": {
            "description": "噪声调度",
            "hint": "填写模型与采样器支持的 noise_schedule，例如 karras、exponential 或 polyexponential。"
          },
          "cfg_rescale": {
            "description": "CFG 重缩放",
            "hint": "范围 0–1；用于调整高 CFG 下的输出，0 表示不重缩放。"
          },
          "img2img_strength": {
            "description": "图生图重绘强度",
            "hint": "范围 0–1，仅有参考图时生效；值越高通常越偏离原图。一次仅支持一张参考图。"
          },
          "img2img_noise": {
            "description": "图生图噪声",
            "hint": "范围 0–1，仅有参考图时生效。"
          }
        },
        "volcengine_ark": {
          "capability_options": {
